{
  "name": "@netdata/charts",
  "version": "7.1.1",
  "description": "Netdata frontend SDK and chart utilities",
  "main": "dist/index.js",
  "module": "dist/es6/index.js",
  "jsnext:main": "dist/es6/index.js",
  "repository": "git@github.com:netdata/charts.git",
  "author": "Netdata",
  "license": "GPL-3.0",
  "private": false,
  "files": [
    "/dist"
  ],
  "scripts": {
    "build:cjs": "babel src --out-dir dist --copy-files --no-copy-ignored --ignore '**/*.stories.js','**/*.test.js','src/mockups/**'",
    "build:es6": "BABEL_ENV=es6 babel src --out-dir dist/es6 --copy-files --no-copy-ignored --ignore '**/*.stories.js','**/*.test.js','src/mockups/**'",
    "build": "yarn build:cjs && yarn build:es6",
    "test": "jest --config ./jest/config.js",
    "lint": "eslint './src/**/*.js'",
    "clean": "rimraf lib dist es coverage",
    "prepublishOnly": "yarn clean && yarn build",
    "cp-cloud": "cp -R ./dist ${CLOUD_DIR:-../cloud-frontend}/node_modules/@netdata/charts/",
    "to-cloud": "yarn build:cjs && yarn build:es6 && yarn cp-cloud",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "perf:bench": "yarn build-storybook --quiet && node scripts/perf-bench.mjs",
    "perf:bench:quick": "node scripts/perf-bench.mjs --quick",
    "format": "prettier --write \"**/*.{js,mjs}\""
  },
  "keywords": [
    "netdata",
    "sdk",
    "frontend",
    "charts"
  ],
  "peerDependencies": {
    "@netdata/netdata-ui": ">=5.6.1",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "styled-components": ">=5.3.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-optional-chaining": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "@netdata/netdata-ui": "5.6.1",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/addon-onboarding": "^10.6.6",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-styled-components": "^2.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.6",
    "styled-components": "^6.3.10",
    "svg-sprite-loader": "^6.0.11",
    "svgo-loader": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "d3": "^7.9.2",
    "d3-scale": "^4.0.3",
    "dygraphs": "^2.2.2",
    "easy-pie-chart": "^3.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "scheduler": "^0.28.0",
    "throttle-debounce": "^5.0.2",
    "uplot": "^1.6.32",
    "uuid": "^14.0.3"
  }
}
